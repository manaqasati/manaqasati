From 68e09f43dce9ef91c781a0ddec6d3af54717ab0b Mon Sep 17 00:00:00 2001
From: Manaqasa Dev <dev@manaqasa.com>
Date: Mon, 10 Aug 2026 15:06:23 +0000
Subject: [PATCH] Fix lock emoji literal in private-price badge; stop labeling
 off-specialty fallback as best opportunity

---
 server/dashboard-provider.html | 2 +-
 server/project.html            | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/server/dashboard-provider.html b/server/dashboard-provider.html
index c42e600..90528ed 100644
--- a/server/dashboard-provider.html
+++ b/server/dashboard-provider.html
@@ -843,7 +843,7 @@ function _renderHome(data){
     var _fbids=parseInt(featured.bid_count||0);
     var _fbidTxt=_fbids===0?'كن أول من يقدّم':(_fbids+' '+(_fbids===1?'عرض':'عروض'));
     html+='<div class="ph-feat">'
-      +'<span class="ph-fb">أفضل فرصة لك'+(matchedBySpec?' · تناسب تخصصك':'')+'</span>'
+      +'<span class="ph-fb">'+(matchedBySpec?'أفضل فرصة لك · تناسب تخصصك':'طلب متاح')+'</span>'
       +'<div onclick="_viewProj('+featured.id+')" style="cursor:pointer;font-size:15px;font-weight:900;color:var(--p);margin:3px 0 9px;line-height:1.4">'+_esc(featured.title||'طلب جديد')+'</div>'
       +'<div style="display:flex;gap:7px;flex-wrap:wrap;margin-bottom:10px">'
         +'<span style="font-size:11px;font-weight:700;background:var(--p-light);color:var(--p2);padding:3px 10px;border-radius:20px">'+_esc(featured.category||'خدمة')+'</span>'
diff --git a/server/project.html b/server/project.html
index ada05bf..dce7679 100644
--- a/server/project.html
+++ b/server/project.html
@@ -477,7 +477,7 @@ function _bidCard(b,isBest,isOwner,reqStatus){
   h+='</div>';
   var _ph = price>0
     ? '<div style="font-family:\'Cairo\',sans-serif;font-size:20px;font-weight:900;color:var(--green);line-height:1">'+fmtN(price)+' <small style="font-size:10px;color:var(--muted);font-weight:700">ر.س</small></div>'
-    : '<div style="display:inline-block;background:#f1f5f9;color:#64748b;font-size:11.5px;font-weight:800;padding:5px 11px;border-radius:20px">\U0001F512 السعر خاص</div>';
+    : '<div style="display:inline-block;background:#f1f5f9;color:#64748b;font-size:11.5px;font-weight:800;padding:5px 11px;border-radius:20px">🔒 السعر خاص</div>';
   h+='<div style="text-align:left;flex-shrink:0">'+_ph+(b.days?'<div style="font-size:11px;color:var(--muted);margin-top:3px">خلال '+b.days+' أيام</div>':'')+'</div>';
   h+='</div>';
   // note
-- 
2.43.0
